@{
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
}
<link href="~/Content/1AdminMenuPage.css" rel="stylesheet" />
<main class="menu-page" ng-init="getUserInfo(); getAdminMenus();">
    <div class="menu-management-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Menu Management</h2>
            <p class="text-muted mb-0">Manage your restaurant menu items</p>
        </div>
        <button class="btn btn-primary btn-add-item shadow-sm" data-bs-toggle="modal" data-bs-target="#menuModal"><i class="bi bi-plus-lg me-1"></i> Add Item</button>
    </div>
    <div class="menu-container">
        <div class="card menu-card shadow-sm border-0" ng-repeat="menus in adminMenu">
            <img class="card-img-top menu-card-img" ng-src="~/Content/StoreFiles/{{menus.Menus.Menu_Image}}">
            <div class="card-body">
                <h5 class="card-title fw-bold mb-1">{{menus.Menus.Menu_Name}}</h5>
                <p class="card-text text-muted small mb-2">{{menus.Menus.Menu_Description}}</p>
                <p class="card-text text-muted small mb-2">{{menus.Menu_Status.Menu_Status_Description}}</p>
                <p class="fw-bold text-success fs-6">₱{{menus.Menus.Menu_Price}}</p>
            </div>
            <div class="card-footer bg-white border-0 d-flex gap-2 p-3">
                <button class="btn btn-outline-danger btn-sm flex-fill"
                        ng-click="delMenu(menus.Menus.Menu_ID)">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </div>
        </div>
        <div class="text-center mt-5" ng-if="adminMenu.length === 0">
            <p class="text-muted">You dont have a menu added at the moment. press "Add Item" to Add one</p>
        </div>
    </div>
    <!-- add Menu -->
    <div class="modal fade" id="menuModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Add Menu To your Restaurant</h5>
                </div>
                <div class="modal-body p-4">
                    <label class="fw-bold">Menu Name</label>
                    <input class="form-control mb-2" ng-model="Menu_Name">

                    <label class="fw-bold">Menu Description</label>
                    <input class="form-control mb-2" ng-model="Menu_Description">

                    <label class="fw-bold">Menu Price</label>
                    <input type="number" class="form-control mb-2" ng-model="Menu_Price">

                    <label class="fw-bold">Status</label>
                    <select class="form-select mb-2" ng-model="Menu_Status">
                        <option value="1">Available</option>
                        <option value="2">Not Available</option>
                    </select>

                    <label class="fw-bold">Menu Image</label>
                    <input type="file" class="form-control" accept="image/*" onchange="angular.element(this).scope().menuImageChanged(this)">
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-primary" ng-click="addMenu()">Save</button>
                    <button class="btn btn-light" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

</main>