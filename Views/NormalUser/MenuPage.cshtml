@{
    Layout = "~/Views/Shared/_NormalLayoutPage.cshtml";
}
<link href="~/Content/1MenuPage.css" rel="stylesheet" />
<main ng-init="getRestoMenus(@ViewBag.Vendor_ID); getUserInfo();">
    <div class="top card mb-4" ng-if="restoMenuInfo">
        <div class="header position-relative d-flex flex-column justify-content-end px-5 pb-5" ng-style="{ 'background-image': 'url(/Content/StoreFiles/' + restoMenuInfo.Vendor.Vendors.Vendor_Store_Picture + ')' }">
            <div>
                <h2 class="text-white fw-bold mb-1">{{restoMenuInfo.Vendor.Vendors.Vendor_Storename}}</h2>
                <p class="text-white mb-0 fs-5">{{restoMenuInfo.Vendor.Category.Category_Description}}</p>
            </div>
        </div>
    </div>
    <div class="Menus mx-auto">
        <h4 class="fw-bold mb-3">Menus</h4>
        <div class="MenuList">
            <div class="card border-0 shadow-sm h-100 menu-card" ng-repeat="menus in restoMenuInfo.Menu">
                <div class="card-body d-flex justify-content-between align-items-center gap-3">
                    <div class="d-flex gap-3 align-items-center">
                        <img ng-src="/Content/StoreFiles/{{menus.Menu_Image}}" class="item-thumb">
                        <div>
                            <h5 class="fw-bold mb-1">{{menus.Menu_Name}}</h5>
                            <p class="text-muted small mb-2">{{menus.Menu_Description}}</p>
                            <h6 class="text-success fw-bold mb-0">₱{{menus.Menu_Price}}</h6>
                        </div>
                    </div>
                    <button class="btn btn-dark rounded-pill px-3" ng-click="addtoOrder(menus)"><i class="bi bi-plus-lg"></i> Add</button>
                </div>
                <div class="text-center mt-5" ng-if="restoMenuInfo.Menu.length === 0">
                    <p class="text-muted">No menus available at the moment</p>
                </div>
            </div>
        </div>
    </div>
</main>