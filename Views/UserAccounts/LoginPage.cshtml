@{
    Layout = "~/Views/Shared/_UserAccountLayoutPage.cshtml";
}
<link href="~/Content/1LoginPage.css" rel="stylesheet" />
<div class="container min-vh-100 d-flex align-items-center">
    <div class="row justify-content-center w-100">
        <div class="col-lg-10">
            <div class="login-card card shadow-lg border-0 login-panel">
                <div class="row g-0">
                    <div class="col-md-6 p-5">
                        <div class="brand-logo h4 text-uppercase mb-4"><i class="bi bi-cart-check"></i>Pick N Serve</div>
                        <h4 class="mb-4">Welcome Back</h4>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="floatingUsername" placeholder="Username" maxlength="50" ng-change="fieldChecker(1)" ng-model="User_Username" required>
                                <label for="floatingUsername">Username*</label>
                            </div>
                            <div class="form-floating mb-4">
                                <input type="password" class="form-control" id="floatingPassword" placeholder="Password" maxlength="128" ng-change="fieldChecker(1)" ng-model="User_Password" required>
                                <label for="floatingPassword">Password*</label>
                            </div>
                            <div class="d-grid">
                                <button class="btn btn-primary" type="submit" ng-disabled="loginDisable" ng-click="Login()">Log In</button>
                            </div>
                            <p class="text-center text-muted mt-4">Don't have an account?<a href="/UserAccounts/RegisterPage" class="btn-register text-primary">Register Now</a></p>
                    </div>
                    <div class="col-md-6 d-md-flex d-none login-image">
                        <div class="right-image">
                            <img src="~/Content/HolyImages/login_img.jpg" alt="Login_images" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>